    "mod-contacts": {
      "title": "Các nhóm luồng Danh bạ & Khách hàng",
      "layoutHint": "tree",
      "direction": "LR",
      "entryNodeIds": [
        "contact-personal",
        "contact-sync-perm",
        "contact-crud-batch",
        "contact-forward-v2"
      ],
      "nodes": [
        {
          "id": "contact-personal",
          "label": "Danh bạ cá nhân (Mini App & SQLite theo tài khoản)",
          "kind": "module",
          "audience": "all",
          "summary": {
            "overview": "Quản lý danh bạ cá nhân với giao diện tìm kiếm A-Z nhanh, phân biệt rõ số chỉ mới lưu trên máy và số đã đồng bộ lên tài khoản VBot; dữ liệu tự tách riêng theo từng tài khoản đăng nhập.",
            "tech": "Tab 3 (UserContactsMiniAppViewController) nhúng Mini App vb-ma-user-contact giao tiếp qua UserContactMiniAppBridgeHelper xuống SQLite user_contacts.sqlite tách biệt theo uid."
          },
          "media": [
            {
              "src": "/media/contacts/contacts-list.webp",
              "caption": "Danh bạ cá nhân phân nhóm A-Z với icon Điện thoại / VBot",
              "type": "image",
              "frame": "phone",
              "audience": "all"
            }
          ],
          "techDetail": {
            "codeRefs": [
              "VBot/Controller/NewController/Contact/UserContactsMiniAppViewController.swift",
              "VBot/Service/UserContactMiniAppBridgeHelper.swift",
              "VBot/Service/Database/UserContactDatabaseHelper.swift"
            ],
            "miniAppBridge": {
              "miniAppId": "vb-ma-user-contact",
              "embedMode": "inline_tab",
              "transport": "UserContactsMiniAppViewController ↔ UserContactMiniAppBridgeHelper (onHostActionRequested)",
              "messages": [
                {
                  "direction": "host_init",
                  "name": "createMiniAppViewController",
                  "hostFn": "UserContactsMiniAppViewController.loadMiniApp() → VbMa.shared.createMiniAppViewController(...)",
                  "miniAppFn": "retrieveLaunchParams() / retrieveAuthData() (@vbotma/sdk)",
                  "payload": "{ id: 'vb-ma-user-contact', locale: 'vi', startParam: 'embedded', extraData: { theme_params, themeParams } }"
                },
                {
                  "direction": "host_to_miniapp",
                  "name": "refresh_data",
                  "hostFn": "UserContactsMiniAppViewController.onTabActivated(forceRefresh:) / refreshData() → miniAppVC.emitEvent(\"refresh_data\", data:)",
                  "miniAppFn": "onHostRefreshData(cb) [hostBridge.ts] → on(\"refresh_data\", cb)",
                  "payload": "{ reason: 'tab_activated' | 'bundle_updated' | 'host_resume', force: Bool }",
                  "note": "Gọi khi kích hoạt tab hoặc app quay lại foreground sau applyPendingBundleUpdate()."
                },
                {
                  "direction": "host_to_miniapp",
                  "name": "theme_changed",
                  "hostFn": "UserContactsMiniAppViewController.syncTheme() → miniAppVC?.emitEvent(\"theme_changed\", data:)",
                  "miniAppFn": "on(\"theme_changed\", cb) (@vbotma/sdk)",
                  "payload": "{ theme_params, theme: 'light' | 'dark' }"
                },
                {
                  "direction": "host_to_miniapp",
                  "name": "toggle_actions_menu",
                  "hostFn": "UserContactsMiniAppViewController.handlePlusTapped() → miniAppVC?.emitEvent(\"toggle_actions_menu\", data:)",
                  "miniAppFn": "onToggleActionsMenu(cb) [hostBridge.ts] → on(\"toggle_actions_menu\", cb)",
                  "payload": "{}",
                  "note": "Bấm nút '+' trên UINavigationBar native của Host để bật/tắt Popover menu trong Mini App."
                },
                {
                  "direction": "host_to_miniapp",
                  "name": "user_contacts_updated",
                  "hostFn": "UserContactsMiniAppViewController.handleReloadUserContacts(_:) → miniAppVC?.emitEvent(\"user_contacts_updated\", data:)",
                  "miniAppFn": "onUserContactsUpdated(cb) [hostBridge.ts] → on(\"user_contacts_updated\", cb)",
                  "payload": "{ reason: 'local_db_changed' }",
                  "note": "Phát khi SQLite thay đổi từ Native; bỏ qua nếu source == 'miniapp_bridge' để chống vòng lặp."
                },
                {
                  "direction": "miniapp_to_host",
                  "name": "user_contact_get_local",
                  "hostFn": "MiniAppService.onHostActionRequested(...) → UserContactMiniAppBridgeHelper.handleAction(...) → executeGetLocal(...)",
                  "miniAppFn": "getLocalContactsState() [hostBridge.ts] → requestHostAction(\"user_contact_get_local\") → postEvent(\"request_host_action\") + on(\"host_action_result\", cb)",
                  "payload": "{ request_id }",
                  "response": "{ request_id, success, uid, permissionStatus, hasImportedDevice, contacts[] }",
                  "note": "Đọc danh bạ SQLite tách biệt theo uid."
                },
                {
                  "direction": "miniapp_to_host",
                  "name": "user_contact_refresh_server",
                  "hostFn": "UserContactMiniAppBridgeHelper.handleAction(...) → UserContactService.shared.loadContacts(...) + executeGetLocal(...)",
                  "miniAppFn": "refreshServerContactsViaHost() [hostBridge.ts] → requestHostAction(\"user_contact_refresh_server\")",
                  "payload": "{ request_id }",
                  "response": "{ uid, permissionStatus, hasImportedDevice, contacts[] }",
                  "note": "Gọi UserContactService.loadContacts tải Server vào SQLite rồi trả danh sách mới."
                },
                {
                  "direction": "miniapp_to_host",
                  "name": "user_contact_import_device",
                  "hostFn": "UserContactMiniAppBridgeHelper.handleAction(...) → UserContactService.shared.fetchDeviceContacts(...) + executeGetLocal(...)",
                  "miniAppFn": "importDeviceContactsViaHost() [hostBridge.ts] → requestHostAction(\"user_contact_import_device\")",
                  "payload": "{ request_id, requestPermission?: Bool }",
                  "response": "{ granted: Bool, permissionStatus, hasImportedDevice, contacts[] }",
                  "note": "Đọc danh bạ iPhone (CNContactStore) và upsert vào SQLite."
                },
                {
                  "direction": "miniapp_to_host",
                  "name": "user_contact_delete_local",
                  "hostFn": "UserContactMiniAppBridgeHelper.handleAction(...) → executeDeleteLocal(...) → UserContactDatabaseHelper.deleteServerContacts / deleteContactsByLocalKeys",
                  "miniAppFn": "deleteLocalContactsViaHost(syncedIds, unsyncedLocalKeys) [hostBridge.ts] → requestHostAction(\"user_contact_delete_local\")",
                  "payload": "{ request_id, syncedIds?: Int64[], unsyncedLocalKeys?: String[] }",
                  "response": "{ deletedCount, contacts[], ... }",
                  "note": "Xóa local SQLite và bắn notification gắn source: 'miniapp_bridge'."
                },
                {
                  "direction": "miniapp_to_host",
                  "name": "user_contact_open_settings",
                  "hostFn": "UserContactMiniAppBridgeHelper.handleAction(...) → UIApplication.shared.open(UIApplication.openSettingsURLString)",
                  "miniAppFn": "openAppSettingsViaHost() [hostBridge.ts] → requestHostAction(\"user_contact_open_settings\")",
                  "payload": "{ request_id }",
                  "response": "{ request_id, success: true }",
                  "note": "Mở màn hình Cài đặt quyền iOS (openSettingsURLString)."
                },
                {
                  "direction": "miniapp_to_host",
                  "name": "make_call",
                  "hostFn": "MiniAppService.onRequestCall(payload:) → VPMAppService.makeCall(...) → sendEvent(\"call_result\", payload:)",
                  "miniAppFn": "makeCallViaHost(contact) [hostBridge.ts] → makeCall(...) (@vbotma/sdk)",
                  "payload": "{ request_id, callee_info | phoneNumber, displayName }",
                  "response": "{ request_id, success }",
                  "note": "Gọi nhanh từ dòng liên hệ giữ nguyên tên hiển thị."
                }
              ]
            }
          }
        },
        {
          "id": "contact-sync-perm",
          "label": "Đồng bộ Server & Xử lý quyền / Đa thiết bị",
          "kind": "module",
          "audience": "all",
          "summary": {
            "overview": "Đẩy danh bạ lên Server để khi đăng nhập ở điện thoại khác vẫn có đầy đủ danh bạ; bảo toàn 100% số đã nạp ngay cả khi người dùng tắt quyền danh bạ máy sau đó.",
            "tech": "Đồng bộ hai chiều qua GET /api/user-contact/get-all và APIService+UserContact, gộp thông minh trên nhiều thiết bị (ưu tiên bản Server) và xử lý danh sách failed_phones."
          },
          "techDetail": {
            "codeRefs": [
              "VBot/Service/UserContactService.swift",
              "VBot/Service/API/Endpoints/APIService+UserContact.swift"
            ]
          }
        },
        {
          "id": "contact-crud-batch",
          "label": "Thêm / Sửa / Xoá hàng loạt (tối đa 50) & Gọi nhanh",
          "kind": "module",
          "audience": "all",
          "summary": {
            "overview": "Thêm mới, chỉnh sửa, vuốt trái thao tác nhanh, chọn xoá tối đa 50 liên hệ một lần hoặc bấm gọi thẳng từ danh bạ / bàn phím nổi.",
            "tech": "Menu '+' và Multi-Select Bar tối đa 50 bản ghi, gọi REST /user-contact/insert|update|delete đồng thời cập nhật SQLite local và truyền tên sang make_call."
          }
        },
        {
          "id": "contact-forward-v2",
          "label": "Danh bạ chuyển tiếp (Tab 1 — Contact V2)",
          "kind": "module",
          "audience": "all",
          "summary": {
            "overview": "Tra cứu danh bạ các đơn vị hành chính, UBND, công an, trạm y tế theo địa bàn/đơn vị để gọi nhanh hoặc chuyển tiếp cuộc gọi đang nghe.",
            "tech": "ContactForwardViewController và ContactV2ViewController sử dụng ContactV2Repository + ContactV2AdvancedFilterBottomSheet."
          },
          "techDetail": {
            "codeRefs": [
              "VBot/Controller/NewController/Contact/ContactForwardViewController.swift",
              "VBot/Controller/NewController/ContactV2/ContactV2ViewController.swift"
            ],
            "miniAppBridge": {
              "miniAppId": "vb-ma-contact-forward",
              "embedMode": "inline_tab",
              "transport": "ContactForwardViewController (embedded + modal 'add') ↔ VbMaDelegate",
              "messages": [
                {
                  "direction": "host_init",
                  "name": "createMiniAppViewController (Tab & Modal)",
                  "hostFn": "ContactForwardViewController.loadMiniApp() / openAddContactForward() → VbMa.shared.createMiniAppViewController(...)",
                  "miniAppFn": "retrieveLaunchParams() / retrieveAuthData() (@vbotma/sdk)",
                  "payload": "Tab: { startParam: 'embedded', extraData: { theme_params } } | Nút '+' native (Admin hoặc CRM:CREATE): { startParam: 'add', onClose → refreshData() }"
                },
                {
                  "direction": "host_to_miniapp",
                  "name": "refresh_data",
                  "hostFn": "ContactForwardViewController.onTabActivated() / refreshData() / handleRefreshNotification() → miniAppVC.emitEvent(\"refresh_data\", data:)",
                  "miniAppFn": "on(\"refresh_data\", cb) [+page.svelte] (@vbotma/sdk)",
                  "payload": "{ reason: 'tab_activated' | 'bundle_updated' | 'host_resume', force: Bool }",
                  "note": "Gọi khi kích hoạt tab, nhận reloadContactV2Noti hoặc đóng modal thêm mới."
                },
                {
                  "direction": "host_to_miniapp",
                  "name": "theme_changed",
                  "hostFn": "ContactForwardViewController.syncTheme() → miniAppVC?.emitEvent(\"theme_changed\", data:)",
                  "miniAppFn": "on(\"theme_changed\", cb) (@vbotma/sdk)",
                  "payload": "{ theme_params, theme: 'light' | 'dark' }"
                },
                {
                  "direction": "miniapp_to_host",
                  "name": "check_permissions / make_call",
                  "hostFn": "MiniAppService.onCheckPermissions(module:actions:) / MiniAppService.onRequestCall(payload:)",
                  "miniAppFn": "checkPermissions(\"CRM\", actions) / makeCall(item.phone, ...) [contact-item.svelte] (@vbotma/sdk/svelte)",
                  "payload": "{ module: 'CRM', actions } / { phoneNumber, displayName }",
                  "response": "{ [action]: Bool } / { success }"
                }
              ]
            }
          }
        }
      ],
      "edges": []
    },
