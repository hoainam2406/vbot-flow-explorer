{
  "name": "vbot-flow-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "BUILD_TARGET=internal vite",
    "dev:public": "BUILD_TARGET=public vite",
    "build:public": "BUILD_TARGET=public vite build --outDir dist-public",
    "build:internal": "BUILD_TARGET=internal vite build --outDir dist-internal",
    "test": "vitest run",
    "validate:data": "tsx scripts/validate-data.ts",
    "audit:sync": "tsx scripts/audit-sync.ts",
    "sync:miniapps": "tsx scripts/sync-miniapps.ts",
    "check:public-leak": "tsx scripts/check-public-leak.ts",
    "media:optimize": "tsx scripts/media-optimize.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
